# Copy this file to .env and fill in your values:  cp .env.example .env
# git ignores .env; uv loads it for one command with --env-file .env.

# Your API key.
OPENAI_API_KEY=your-api-key

# The endpoint. This line is OpenAI's own endpoint. For Azure OpenAI, use your resource's endpoint,
# https://YOUR-RESOURCE.services.ai.azure.com/openai/v1, and name your deployment as the agent's model:
# --agent codex:YOUR-DEPLOYMENT in the Experiment examples (wse run --controller codex takes it as --model).
OPENAI_BASE_URL=https://api.openai.com/v1
